{
  "name": "daily-golf",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w @golf/server\" \"npm run dev -w @golf/client\"",
    "build": "npm run build -w @golf/client",
    "start": "npm run start -w @golf/server",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "batch": "tsx packages/tools/src/batch.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
